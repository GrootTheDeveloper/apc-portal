NODE_ENV=development
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_HOST=127.0.0.1
API_PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Máy đã có PostgreSQL chiếm cổng 5432: đổi POSTGRES_PORT (vd 5433) và sửa cổng trong DATABASE_URL cho khớp.
POSTGRES_PORT=5432
POSTGRES_DB=apc_portal
POSTGRES_USER=apc
POSTGRES_PASSWORD=apc_local_only
DATABASE_URL=postgresql://apc:apc_local_only@localhost:5432/apc_portal

# Email: local gửi vào Mailpit (xem thư ở http://localhost:8025), không cần user/password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="APC Portal <no-reply@apc.local>"

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=apc_local
S3_SECRET_KEY=apc_local_only
S3_BUCKET=apc-portal
# Cloudflare R2 dùng `auto`; SeaweedFS chấp nhận giá trị bất kỳ.
S3_REGION=auto

# Quét mã độc tệp tải lên (D2). Local/CI để `skip` (mọi tệp coi là sạch, log cảnh báo).
# Production bắt buộc `clamav`, nếu không API không khởi động. Bật ClamAV local: xem docs/07 mục 10.6.
FILE_SCAN_MODE=skip
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Mật khẩu chung của tài khoản mẫu (db:seed). Chỉ dùng local.
SEED_PASSWORD=apc_local_seed_only

# Khóa mã hóa secret TOTP và băm mã khôi phục (B3, SEC-16). Hex 64 ký tự (32 byte). Giá trị này công khai trong repo:
# chỉ dùng local; production phải tạo khóa riêng (`openssl rand -hex 32`), dùng khóa mẫu thì API không khởi động.
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret TOTP (base32) cố định của `board` và `techadmin` trong dữ liệu mẫu, để thêm vào app Authenticator hoặc
# để e2e sinh mã (apps/web/e2e/helpers.ts). Chỉ dùng local/CI.
SEED_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Ngưỡng tối thiểu 2 BOARD và 2 TECH_ADMIN đang hoạt động (RP-06, RP-07). Local để false; bật sau khi production phát hành.
ENFORCE_PRIVILEGED_MINIMUM=false
