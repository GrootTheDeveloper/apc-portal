NODE_ENV=development
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_HOST=127.0.0.1
API_PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Máy đã có PostgreSQL chiếm cổng 5432: đổi POSTGRES_PORT (vd 5433) và sửa cổng trong DATABASE_URL cho khớp.
POSTGRES_PORT=5432
POSTGRES_DB=apc_portal
POSTGRES_USER=apc
POSTGRES_PASSWORD=apc_local_only
DATABASE_URL=postgresql://apc:apc_local_only@localhost:5432/apc_portal

SMTP_HOST=localhost
SMTP_PORT=1025

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=apc_local
S3_SECRET_KEY=apc_local_only
S3_BUCKET=apc-portal

# Mật khẩu chung của tài khoản mẫu (db:seed). Chỉ dùng local.
SEED_PASSWORD=apc_local_seed_only
