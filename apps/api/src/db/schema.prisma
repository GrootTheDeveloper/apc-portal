generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

// MEMBER là vai trò nền của mọi tài khoản (RP-01), không lưu trong user_roles.
// user_roles chỉ lưu DEPARTMENT_MANAGER, BOARD, TECH_ADMIN.
enum Role {
  MEMBER
  DEPARTMENT_MANAGER
  BOARD
  TECH_ADMIN
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  LOCKED
  INACTIVE
}

// Trạng thái thành viên CLB — độc lập với AccountStatus, trừ LEFT: chuyển LEFT thì tài khoản INACTIVE (MEM-11, RP-09)
enum MemberStatus {
  ACTIVE
  PAUSED
  LEFT
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

// Dùng cho Post và Project. Project: DRAFT = Ẩn, PUBLISHED = Công khai (PRT-03).
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Phạm vi bài viết / thông báo (CMS-05)
enum ContentScope {
  PUBLIC
  INTERNAL
}

enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// Trạng thái gán vai trò (ADM-08, STATE-14)
enum RoleAssignmentStatus {
  PENDING
  ACTIVE
  EXPIRED
  REVOKED
}

// Trạng thái sự kiện (EVT-12, docs/01 §9.2)
enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
  ARCHIVED
}

enum RecruitmentRoundStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum DeliveryStatus {
  PENDING
  SENDING
  RETRY
  SENT
  FAILED
}

enum AuditActorType {
  USER
  SERVICE
}

enum AuditCategory {
  BUSINESS
  SECURITY
  OPERATIONS
}

enum AuditResult {
  SUCCESS
  FAILURE
}

// Chủ thể của một lần đồng ý (B2)
enum ConsentSubjectType {
  APPLICATION
  EVENT_REGISTRATION
  USER
}

// Mục đích đồng ý (REC-04, EVT-14, MEM-12)
enum ConsentPurpose {
  RECRUITMENT_PROCESSING
  EVENT_REGISTRATION
  PUBLIC_NAME
  PUBLIC_PHOTO
  PUBLIC_PROFILE // thông tin cá nhân khác: kỹ năng, lĩnh vực quan tâm
}

// Mục đích tệp tải lên (D2)
enum FilePurpose {
  CONTENT_IMAGE // Ảnh bài viết, dự án, sự kiện
  AVATAR // Ảnh đại diện — luôn INTERNAL (MEM-10)
  DOCUMENT // Tài liệu nội bộ — chỉ tải qua thư viện tài liệu (D4)
}

// Server quyết định, không nhận từ client (D2)
enum FileVisibility {
  PUBLIC
  INTERNAL
}

// Trạng thái quét mã độc (SEC-15, STATE-05). PENDING là vùng cách ly: không đường tải nào trả tệp chưa CLEAN.
enum FileScanStatus {
  PENDING
  CLEAN
  REJECTED
}

// MODELS — TỔ CHỨC

// Thông tin CLB — singleton (1 dòng duy nhất, id = "singleton")
// T2: SiteSetting.termEndsAt không trả ra /public/about; A6, A7 dùng để giới hạn ngày hết hạn vai trò đặc quyền (QĐ-6)
model SiteSetting {
  id String @id @default("singleton")

  // Thông tin CLB công khai (JSON) — trả ra GET /public/about
  info Json // { name, description, mission, contactEmail, fanpage, officialLinks }

  // Ngày kết thúc nhiệm kỳ Ban Chủ nhiệm hiện tại (RP-03, QĐ-6) — KHÔNG trả ra API công khai
  termEndsAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Department {
  id           String           @id @default(cuid())
  name         String
  code         String           @unique
  description  String?
  // Đầu mối liên hệ chung của ban: email ban, fanpage hoặc chức danh (ORG-02)
  // KHÔNG phải tên, email, SĐT cá nhân (BR-20, DATA-03)
  contactPoint String?
  status       DepartmentStatus @default(ACTIVE)
  order        Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users        User[]
  roles        UserRole[]
  posts        Post[]
  events       Event[]
  projects     Project[]
  applications MembershipApplication[]
  deliveries   NotificationDelivery[]

  @@map("departments")
}

// MODELS — NGƯỜI DÙNG
// Hồ sơ thành viên (MEM-02, thực thể MemberProfile trong docs/01 §9) gộp thẳng vào User.
model User {
  id           String        @id @default(cuid())
  username     String        @unique // Tên đăng nhập (AUTH-02, BR-02)
  email        String        @unique
  passwordHash String // Băm Argon2id (SEC-02)
  status       AccountStatus @default(PENDING_ACTIVATION)

  mustChangePassword         Boolean   @default(true)
  isTemporaryPassword        Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime? // BR-04: hết hạn sau 72h
  passwordChangedAt          DateTime?

  failedLoginAttempts Int       @default(0) // SEC-05
  lockoutUntil        DateTime?

  // Hồ sơ (MEM-02) — gộp trực tiếp
  fullName      String
  studentId     String? @unique // Optional: tài khoản bootstrap đầu tiên có thể chưa gắn MSSV
  faculty       String?
  major         String?
  cohort        String?
  avatarUrl     String?
  phoneNumber   String?
  skills        Json?
  interestAreas Json?

  departmentId String? // Ban đang hoạt động; khác phạm vi quản lý trong user_roles
  department   Department?  @relation(fields: [departmentId], references: [id])
  memberStatus MemberStatus @default(ACTIVE) // MEM-11: độc lập AccountStatus, trừ LEFT kéo theo INACTIVE
  deactivatedAt DateTime? // A5: lúc chuyển INACTIVE; B7 dùng để tính hạn lưu giữ dữ liệu

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles        UserRole[] @relation("RoleHolder")
  grantedRoles UserRole[] @relation("RoleGrantor")
  revokedRoles UserRole[] @relation("RoleRevoker")
  roleDecisionsAbout    RoleDecision[] @relation("RoleDecisionTarget")
  roleDecisionsMade     RoleDecision[] @relation("RoleDecisionDecider")
  roleDecisionsExecuted RoleDecision[] @relation("RoleDecisionExecutor")
  sessions     Session[]
  auditLogs    AuditLog[]

  authoredPosts  Post[] @relation("PostAuthor")
  publishedPosts Post[] @relation("PostPublisher")

  createdEvents Event[] @relation("EventCreator")

  createdRounds RecruitmentRound[]      @relation("RoundCreator")
  reviewedApps  MembershipApplication[] @relation("ReviewedBy")

  createdProjects          Project[]              @relation("ProjectCreator")
  convertedFromApplication MembershipApplication? @relation("ApplicationConversion")

  uploadedFiles StoredFile[] @relation("FileUploader")

  @@map("users")
}

enum RoleDecisionAction {
  GRANT
  REVOKE
}

enum RoleDecisionStatus {
  PENDING
  EXECUTED
  CANCELLED
}

// A6 — quyết định gán/thu hồi TECH_ADMIN theo quy trình DUAL (Vai trò & quyền §8.6, FLOW-20):
// BOARD ghi quyết định → hiện ở /admin/access-control → một TECH_ADMIN khác đang hoạt động thực hiện.
model RoleDecision {
  id     String             @id @default(cuid())
  action RoleDecisionAction
  role   Role // hiện chỉ dùng cho TECH_ADMIN

  userId String
  user   User   @relation("RoleDecisionTarget", fields: [userId], references: [id])
  userRoleId String? // REVOKE: dòng user_roles bị thu hồi; GRANT: dòng được tạo khi thực hiện
  expiresAt  DateTime? // GRANT: ngày hết hạn của vai trò, không muộn hơn SiteSetting.termEndsAt (RP-03)
  reason     String

  status       RoleDecisionStatus @default(PENDING)
  decidedById  String
  decidedBy    User      @relation("RoleDecisionDecider", fields: [decidedById], references: [id])
  executedById String?
  executedBy   User?     @relation("RoleDecisionExecutor", fields: [executedById], references: [id])
  executedAt   DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("role_decisions")
}

// Gán vai trò quản lý/đặc quyền (docs/02 §9). Một người có thể có nhiều dòng,
// ví dụ quản lý 2 ban. Không được vừa BOARD vừa TECH_ADMIN (BR-21) — kiểm ở service.
model UserRole {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("RoleHolder", fields: [userId], references: [id])
  role   Role

  departmentId String? // Bắt buộc khi role = DEPARTMENT_MANAGER (RP-02)
  department   Department? @relation(fields: [departmentId], references: [id])

  status    RoleAssignmentStatus @default(PENDING) // BOARD/TECH_ADMIN chỉ ACTIVE sau TOTP (RP-13)
  startsAt  DateTime
  expiresAt DateTime? // Bắt buộc với BOARD/TECH_ADMIN: không muộn hơn hết nhiệm kỳ (RP-03)
  reason    String // RP-11

  grantedById String? // null khi tạo bằng bootstrap (RP-15)
  grantedBy   User?     @relation("RoleGrantor", fields: [grantedById], references: [id])
  revokedById String?
  revokedBy   User?     @relation("RoleRevoker", fields: [revokedById], references: [id])
  revokedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("user_roles")
}

// Phiên đăng nhập lưu ở server (docs/06 §5). Cookie chỉ chứa token ngẫu nhiên; DB lưu hash.
model Session {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  tokenHash String @unique // SHA-256 của token trong cookie

  twoFactorVerified Boolean @default(false) // Phiên đã qua TOTP, mới dùng được quyền đặc quyền (FLOW-27)

  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now()) // Hết hạn sau 8 giờ không hoạt động (SEC-06)
  revokedAt    DateTime? // Đăng xuất, đổi mật khẩu, khóa tài khoản (AUTH-08)
  ipAddress    String?
  userAgent    String?

  @@index([userId])
  @@map("sessions")
}

// MODELS — NỘI DUNG (CMS)

model Post {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  summary      String
  content      String
  thumbnailUrl String?
  category     String
  scope        ContentScope  @default(PUBLIC) // CMS-05
  status       ContentStatus @default(DRAFT)

  authorId      String
  author        User        @relation("PostAuthor", fields: [authorId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  publishedById String?
  publishedBy   User?       @relation("PostPublisher", fields: [publishedById], references: [id])
  publishedAt   DateTime?

  metaTitle       String? // SEO-01
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("posts")
}

// MODELS — SỰ KIỆN
//
// Bảng đăng ký/điểm danh (EventRegistration) thêm ở việc E2 (docs/plan/E-su-kien.md).

model Event {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String
  coverImageUrl String?
  eventType     String // Loại/chuyên mục: Workshop, Training, Contest...
  status        EventStatus @default(DRAFT)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  contactPoint String?

  createdById String
  createdBy   User    @relation("EventCreator", fields: [createdById], references: [id])
  location    String?

  startAt DateTime
  endAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("events")
}

// MODELS — DỰ ÁN

model Project {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  thumbnailUrl String?
  technologies Json? // ["React", "Node.js", "PostgreSQL"]
  projectUrl   String?
  sourceUrl    String?
  status       ContentStatus @default(DRAFT)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  publishedAt  DateTime?

  createdById String
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("projects")
}

// MODELS — TUYỂN DỤNG
//
// Câu hỏi đợt tuyển: cột JSON `questions` trên RecruitmentRound, thêm ở việc R2.
// ConsentRecord thêm ở việc B2 (docs/plan/B-bao-mat.md), dùng chung cho R3 và E3.

model RecruitmentRound {
  id          String                 @id @default(cuid())
  title       String
  slug        String                 @unique
  description String
  status      RecruitmentRoundStatus @default(DRAFT)
  opensAt     DateTime
  closesAt    DateTime

  createdById String
  createdBy   User   @relation("RoundCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications MembershipApplication[]

  @@map("recruitment_rounds")
}

model MembershipApplication {
  id                 String           @id @default(cuid())
  profileCode        String           @unique // Mã tra cứu công khai CSPRNG (REC-06)
  recruitmentRoundId String
  recruitmentRound   RecruitmentRound @relation(fields: [recruitmentRoundId], references: [id])

  applicantName       String
  applicantEmail      String
  studentId           String
  faculty             String?
  major               String?
  cohort              String?
  desiredDepartmentId String?
  desiredDepartment   Department? @relation(fields: [desiredDepartmentId], references: [id])
  skills              String?
  experience          String?
  answers             Json? // Câu trả lời, lưu theo id câu hỏi trong RecruitmentRound.questions

  status       ApplicationStatus @default(NEW)
  internalNote String? // BR-07: không hiển thị cho ứng viên
  reviewedById String?
  reviewedBy   User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Chuyển thành viên khi ACCEPTED — trỏ thẳng vào User vì đã gộp profile
  convertedUserId String?   @unique
  convertedUser   User?     @relation("ApplicationConversion", fields: [convertedUserId], references: [id])
  convertedAt     DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([recruitmentRoundId, applicantEmail]) // REC-05
  @@unique([recruitmentRoundId, studentId]) // BR-05
  @@index([applicantEmail])
  @@index([recruitmentRoundId])
  @@map("membership_applications")
}

// MODELS — EMAIL (O1)

// Một email cần gửi. Không lưu nội dung đã dựng: worker đọc bản ghi gốc theo refType + refId lúc gửi,
// nên mã hồ sơ, mã đăng ký không bao giờ nằm trong bảng này (FLOW-26, OPS-11).
model NotificationDelivery {
  id            String         @id @default(cuid()) // Cũng là idempotency key: Message-ID sinh từ id
  type          String // Tên mẫu email, khớp với modules/email/templates.ts
  recipient     String
  refType       String // Loại bản ghi gốc, vd APPLICATION, EVENT_REGISTRATION
  refId         String
  departmentId  String? // Ban liên quan, để O3 lọc theo phạm vi ban
  department    Department?    @relation(fields: [departmentId], references: [id])
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  nextAttemptAt DateTime       @default(now())
  lockedAt      DateTime? // Lúc worker nhận xử lý (SENDING); kẹt quá 10 phút thì được nhận lại
  messageId     String? // Message-ID nhà cung cấp trả về, đã làm sạch
  lastError     String? // Lỗi gần nhất, đã làm sạch
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([refType, refId])
  @@index([departmentId])
  @@map("notification_deliveries")
}

// MODELS — KIỂM TOÁN (AUDIT - B1)

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType @default(USER)
  actorId     String?
  actor       User?          @relation(fields: [actorId], references: [id])
  serviceName String?
  actorRole   Role?
  action      String
  targetType  String
  targetId    String?
  category    AuditCategory
  result      AuditResult
  reason      String?
  incidentId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// MODELS — QUYỀN RIÊNG TƯ (B2)

// Mỗi lần đồng ý một dòng; thu hồi thì ghi revokedAt, không xóa dòng (DATA-07).
// Không lưu email/IP/trình duyệt: chủ thể là hồ sơ ứng tuyển, đăng ký sự kiện hoặc tài khoản đã có sẵn dữ liệu đó.
model ConsentRecord {
  id            String             @id @default(cuid())
  subjectType   ConsentSubjectType
  subjectId     String
  purpose       ConsentPurpose
  // Đối tượng áp dụng, vd. một dự án cụ thể (MEM-12). Để trống là áp dụng chung.
  targetType    String?
  targetId      String?
  policyVersion String
  grantedAt     DateTime           @default(now())
  revokedAt     DateTime?

  @@index([subjectType, subjectId, purpose])
  @@map("consent_records")
}

// MODELS — TỆP (D2)

// Một tệp trong kho S3. Khóa kho ngẫu nhiên, không dùng tên gốc; không bao giờ trả khóa/URL kho ra API.
// Tệp REJECTED đã bị xóa khỏi kho nhưng giữ dòng làm dấu vết bảo mật.
model StoredFile {
  id           String         @id @default(cuid())
  storageKey   String         @unique
  originalName String
  mimeType     String // Loại xác định từ nội dung tệp, không theo đuôi file/header
  size         Int // byte
  purpose      FilePurpose
  visibility   FileVisibility @default(INTERNAL)
  scanStatus   FileScanStatus @default(PENDING)
  scannedAt    DateTime?

  uploadedById String
  uploadedBy   User   @relation("FileUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scanStatus, createdAt])
  @@index([uploadedById])
  @@map("stored_files")
}
